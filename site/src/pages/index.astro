---
/**
 * index.astro — the wicked-testing product landing page (wt.wickedagile.com).
 *
 * Wave-4 reimagination. Concept: THE WALL — the agent that runs the tests can
 * never be the one that grades them. Enforced separation between authorship and
 * judgment is wicked-testing's single idea, so the page is built around a dashed
 * accent barrier and a live evidence handoff across it (the reviewer-isolation
 * band). Distinct from the family's graph / terminal / console techniques.
 *
 * Consumes the shared wicked-web chrome (Base + Topbar + Footer + SameGarden)
 * and the family design tokens; page-specific content styles live in
 * ../styles/testing.css. Theming is driven by [data-theme]; this page adds no
 * chrome or theme system of its own.
 *
 * Every claim is code-grounded against the wicked-testing repo (v0.7.3):
 *   40 agents (15 Tier-1 public contract + 25 Tier-2 specialists),
 *   47 installable skills, 5 Tier-1 orchestrator surfaces,
 *   a 3-agent acceptance pipeline (Writer → Executor → Reviewer) with tool
 *   boundaries taken from each agent's `allowed-tools` frontmatter, and the
 *   pending wicked-qe rename (bin alias already ships). Messaging is locked to
 *   scratch/marketing/CANONICAL-MESSAGING.md (Wave-4 top).
 */
import Base from 'wicked-web/layouts/Base.astro';
import Topbar from 'wicked-web/components/Topbar.astro';
import Footer from 'wicked-web/components/Footer.astro';
import SameGarden from 'wicked-web/components/SameGarden.astro';
import '../styles/testing.css';

const title = 'wicked-testing — no agent grades its own homework';
const description = 'When an AI agent tests its own work it grades its own homework — self-reported PASS rates run 80%+ above human-reviewed rates. wicked-testing gives your AI CLI a complete QE team from planning through execution through judgment, with an enforced wall between the agent that runs the tests and the agent that evaluates them. Local-first, SQLite-backed, MIT. Published to npm as wicked-testing v0.7.3.';
const repo = 'https://github.com/mikeparcewski/wicked-testing';

// The eight AI CLIs the installer targets (install.mjs).
const CLIS = ['Claude Code', 'Antigravity', 'Cursor', 'Codex', 'Kiro', 'Copilot', 'OpenCode', 'Pi'];

// The 40 agents, grounded against agents/ (15 Tier-1) + agents/specialists/ (25).
// `surface` = the Tier-1 orchestrator skill each agent serves (plan / authoring
// / execution / review / insight). tier 1 = stable public contract.
const AGENTS = [
  // plan
  { n: 'test-strategist', s: 'plan', t: 1 },
  { n: 'risk-assessor', s: 'plan', t: 1 },
  { n: 'testability-reviewer', s: 'plan', t: 1 },
  { n: 'requirements-quality-analyst', s: 'plan', t: 1 },
  { n: 'code-analyzer', s: 'plan', t: 1 },
  { n: 'coverage-archaeologist', s: 'plan', t: 2 },
  { n: 'test-impact-analyzer', s: 'plan', t: 2 },
  // authoring
  { n: 'acceptance-test-writer', s: 'authoring', t: 1 },
  { n: 'test-designer', s: 'authoring', t: 1 },
  { n: 'test-automation-engineer', s: 'authoring', t: 1 },
  { n: 'contract-testing-engineer', s: 'authoring', t: 1 },
  { n: 'ui-component-test-engineer', s: 'authoring', t: 2 },
  { n: 'integration-test-engineer', s: 'authoring', t: 2 },
  { n: 'e2e-orchestrator', s: 'authoring', t: 2 },
  { n: 'fuzz-property-engineer', s: 'authoring', t: 2 },
  { n: 'test-data-manager', s: 'authoring', t: 2 },
  { n: 'incident-to-scenario-synthesizer', s: 'authoring', t: 2 },
  // execution
  { n: 'acceptance-test-executor', s: 'execution', t: 1 },
  { n: 'scenario-executor', s: 'execution', t: 1 },
  { n: 'load-performance-engineer', s: 'execution', t: 2 },
  { n: 'chaos-test-engineer', s: 'execution', t: 2 },
  { n: 'security-test-engineer', s: 'execution', t: 2 },
  { n: 'a11y-test-engineer', s: 'execution', t: 2 },
  { n: 'mutation-test-engineer', s: 'execution', t: 2 },
  { n: 'ai-feature-test-engineer', s: 'execution', t: 2 },
  { n: 'iac-test-engineer', s: 'execution', t: 2 },
  { n: 'localization-test-engineer', s: 'execution', t: 2 },
  { n: 'observability-test-engineer', s: 'execution', t: 2 },
  { n: 'data-quality-tester', s: 'execution', t: 2 },
  { n: 'visual-regression-engineer', s: 'execution', t: 2 },
  { n: 'exploratory-tester', s: 'execution', t: 2 },
  // review
  { n: 'acceptance-test-reviewer', s: 'review', t: 1 },
  { n: 'semantic-reviewer', s: 'review', t: 1 },
  { n: 'test-code-quality-auditor', s: 'review', t: 2 },
  { n: 'snapshot-hygiene-auditor', s: 'review', t: 2 },
  { n: 'flaky-test-hunter', s: 'review', t: 2 },
  { n: 'release-readiness-engineer', s: 'review', t: 2 },
  // insight
  { n: 'test-oracle', s: 'insight', t: 1 },
  { n: 'production-quality-engineer', s: 'insight', t: 1 },
  { n: 'compliance-test-engineer', s: 'insight', t: 2 },
];

const SURFACES = [
  { key: 'plan', line: 'Shift-left strategy — strategist, risk, testability, AC-quality.' },
  { key: 'authoring', line: 'Author scenarios and generate test code in your framework.' },
  { key: 'execution', line: 'Run scenarios and capture evidence. No judgment.' },
  { key: 'review', line: 'Independent verdict from cold evidence. Gap Report per criterion.' },
  { key: 'insight', line: 'Domain health and history, answered by a fixed-SQL oracle.' },
];
const surfaceCount = (k) => AGENTS.filter((a) => a.s === k).length;

// Evidence that crosses the wall vs signals blocked at it.
const CROSSES = ['manifest.json', 'evidence.json', 'step-N.json', 'context.md'];
const BLOCKED = ['executor context', 'chain-of-thought', 'raw stdout', 'prior verdicts'];
---

<Base title={title} description={description}>
  <Topbar pkg="wicked-testing" repo={repo} />

  <!-- ── Hero — intro + install SIDE BY SIDE ──────────────────────────────── -->
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-lead">
        <span class="kicker">A QE team for AI coding CLIs</span>
        <h1>No agent grades <span class="y">its own homework.</span></h1>
        <p class="lede">
          When an AI agent tests its own work, it grades its own homework —
          self-reported PASS rates run <b>80%+ above</b> human-reviewed rates.
          wicked-testing gives your CLI a full QE team, then puts a
          <b>wall</b> between the agent that runs the tests and the agent that
          decides they passed.
        </p>
      </div>

      <div class="hero-side">
        <div class="install" role="group" aria-label="Install wicked-testing">
          <div class="install__bar">
            <span class="install__label">Install · the wicked family</span>
            <button class="install__copy" type="button" aria-label="Copy install command"
              onclick="navigator.clipboard&&navigator.clipboard.writeText('npx wicked-installer').then(()=>{this.textContent='Copied';setTimeout(()=>{this.textContent='Copy';},1400);})">Copy</button>
          </div>
          <pre class="install__code"><code><span class="p">npx</span> wicked-installer</code></pre>
          <p class="install__alt">
            Interactive · cross-CLI · ships the <code>wicked</code> CLI.
            <span class="install__or">or just this:</span> <code>npx wicked-testing install</code>
          </p>
        </div>
        <div class="cli-row" aria-label="Supported AI coding CLIs">
          <span class="cli-lbl">Installs into 8 CLIs</span>
          {CLIS.map((c) => <span class="cli-chip">{c}</span>)}
        </div>
      </div>
    </div>
  </section>

  <!-- ── The gap — the self-grading problem (side-by-side) ────────────────── -->
  <section class="band">
    <div class="wrap gap-grid">
      <div class="card-fig" id="cardfig" data-revealed="false">
        <div class="card-fig-h"><span>report card · same feature</span><span>run #0.7.3</span></div>
        <div class="grades">
          <div class="grade-cell grade-cell--self">
            <span class="grade-tag">author grades itself</span>
            <div class="grade-mark">PASS</div>
            <div class="grade-sub">100% · every time</div>
            <span class="stamp">self-reported</span>
          </div>
          <div class="grade-cell grade-cell--rev">
            <span class="grade-tag">independent reviewer</span>
            <div class="grade-mark grade-mark--rev" data-revmark>PASS</div>
            <div class="grade-sub" data-revsub>awaiting review…</div>
            <span class="stamp">contradicted</span>
          </div>
        </div>
        <div class="gap-delta"><b>80%+</b> of self-graded PASSes don't survive an independent read.</div>
        <button class="gap-btn" type="button" data-reveal aria-pressed="false">Send it to an independent reviewer →</button>
        <p class="gap-note">Illustrative of the measured self-grading gap.</p>
      </div>

      <div class="gap-copy">
        <span class="kicker">The self-grading problem</span>
        <h2>The agent that wrote the code runs the tests — and calls them green.</h2>
        <p>
          There's no independence at any layer. Scripted frameworks —
          Playwright, pytest, k6, axe-core — only run what you already thought
          to test. They don't tell you <em>what</em> to test, whether the tests
          are any good, or whether the results mean anything.
        </p>
        <p class="kick">wicked-testing separates authorship from judgment — and enforces it.</p>
      </div>
    </div>
  </section>

  <!-- ── THE WALL — reviewer isolation (ONE SCREEN) ───────────────────────── -->
  <section class="wall-band" id="wall">
    <div class="wrap">
      <div class="head-top">
        <span class="kicker">The differentiator · reviewer isolation</span>
        <h2>The reviewer never sees who did the work.</h2>
        <p class="sec-sub">
          The 3-agent acceptance pipeline gives each role its own tool boundary.
          The reviewer reads <b>cold evidence files only</b> — never the
          executor's context, reasoning, or stdout — so the self-grading that
          inflates AI PASS rates has nowhere to hide. Watch what crosses the wall.
        </p>
      </div>

      <div class="stage is-playing" id="stage" role="group" aria-label="Live evidence handoff across the reviewer wall">
        <div class="role" data-role="0">
          <span class="role-n">Step 1 · authors</span>
          <span class="role-name">Writer</span>
          <span class="role-tools"><span class="role-tool">Read</span><span class="role-tool">Grep</span><span class="role-tool">Glob</span><span class="role-tool">Skill</span></span>
          <p>Turns the scenario into an evidence-gated plan — every step declares its expected evidence and an assertion. Can't execute.</p>
        </div>

        <div class="role" data-role="1">
          <span class="role-n">Step 2 · runs</span>
          <span class="role-name">Executor</span>
          <span class="role-tools"><span class="role-tool">Read</span><span class="role-tool">Write</span><span class="role-tool">Bash</span></span>
          <p>Follows the plan mechanically. Captures stdout, exit codes, and artifacts. Makes <b>no judgment</b>.</p>
        </div>

        <div class="wall" aria-hidden="true"><span class="wall-tag">cold evidence only</span></div>

        <div class="role role--reviewer is-lit" data-role="2">
          <span class="role-n">Step 3 · judges</span>
          <span class="role-name">Reviewer</span>
          <span class="role-tools"><span class="role-tool">Read</span></span>
          <p>Reads the evidence files and <b>nothing else</b>. Never sees how they were produced. One tool — <code>Read</code>. Can't execute.</p>
        </div>

        <!-- the live channel: evidence chips cross, reasoning bounces off -->
        <div class="channel" aria-hidden="true">
          <span class="chip chip--pass" style="top:26%;animation-delay:0s">manifest.json</span>
          <span class="chip chip--pass" style="top:70%;animation-delay:1.3s">evidence.json</span>
          <span class="chip chip--pass" style="top:44%;animation-delay:2.6s">step-N.json</span>
          <span class="chip chip--pass" style="top:84%;animation-delay:3.9s">context.md</span>
          <span class="chip chip--block" style="top:36%;animation-delay:.6s">executor context</span>
          <span class="chip chip--block" style="top:58%;animation-delay:1.9s">chain-of-thought</span>
          <span class="chip chip--block" style="top:16%;animation-delay:3.2s">raw stdout</span>
          <span class="chip chip--block" style="top:78%;animation-delay:4.5s">prior verdicts</span>
        </div>
      </div>

      <div class="wall-legend">
        <div class="leg leg--pass">
          <div class="leg-h"><span class="leg-dot"></span>Crosses the wall — the reviewer reads</div>
          <div class="leg-items">{CROSSES.map((f) => <span><code>{f}</code></span>)}</div>
        </div>
        <div class="leg leg--block">
          <div class="leg-h"><span class="leg-dot"></span>Bounced at the wall — never seen</div>
          <div class="leg-items">{BLOCKED.map((f) => <span>{f}</span>)}</div>
        </div>
      </div>

      <p class="wall-foot">
        Cold context injection hands the reviewer <b>non-prejudicial</b> domain
        knowledge only — WCAG thresholds, tool quirks. Prior verdicts or pass/fail
        rates leak nothing: prejudicial content trips
        <code>INCONCLUSIVE + CONTEXT_CONTAMINATION</code>. Isolation is enforced by
        the reviewer's <code>context: fork</code> boundary and an <code>allowed-tools: Read</code> frontmatter.
      </p>
    </div>
  </section>

  <!-- ── The fleet — 40 agents, filter by orchestrator surface ────────────── -->
  <section class="band fleet-band">
    <div class="wrap">
      <div class="head-top">
        <span class="kicker">A complete QE team</span>
        <h2>Forty specialist agents. Five orchestrators. One contract.</h2>
        <p class="sec-sub">
          <b>40 agents</b> behind five Tier-1 orchestrator skills, shipped as
          <b>47 installable skills</b>. The <b>15 Tier-1</b> agents are a stable
          public contract; <b>25 Tier-2</b> specialists route beneath them. Pick a
          surface — see who reports to it.
        </p>
      </div>

      <div class="fleet-filter" id="fleetFilter" role="tablist" aria-label="Filter agents by orchestrator surface">
        <span class="fleet-lbl">Surface</span>
        <button class="f-btn is-on" role="tab" type="button" data-surf="all" aria-selected="true">all<span class="f-n">40</span></button>
        {SURFACES.map((s) => (
          <button class="f-btn" role="tab" type="button" data-surf={s.key} aria-selected="false" title={s.line}>
            /{s.key}<span class="f-n">{surfaceCount(s.key)}</span>
          </button>
        ))}
      </div>

      <div class="fleet-grid" id="fleetGrid">
        {AGENTS.map((a) => (
          <div class="agent" data-surf={a.s} data-tier={a.t}>
            <span class="agent-dot" aria-hidden="true"></span>
            <span class="agent-name">{a.n}</span>
          </div>
        ))}
      </div>

      <div class="fleet-legend">
        <span><span class="fl-dot fl-dot--t1"></span>Tier-1 · public contract (15)</span>
        <span><span class="fl-dot fl-dot--t2"></span>Tier-2 · internal specialists (25)</span>
        <span>every skill ships with <code>context: fork</code></span>
      </div>
    </div>
  </section>

  <!-- ── The ledger — evidence (side-by-side) ─────────────────────────────── -->
  <section class="band">
    <div class="wrap ledger-grid">
      <div>
        <span class="kicker">Evidence, not assertions</span>
        <h2>Every verdict traces to the evidence that produced it.</h2>
        <p>
          Records write JSON first (fsync'd), then SQLite — a WAL-mode ledger
          with a fixed-SQL test oracle and <b>no ad-hoc SQL</b>. On SQLite
          failure the store degrades to JSON-only and keeps running. Every record
          carries <code>run_id</code>, <code>scenario_id</code>, <code>agent</code>,
          and <code>verdict</code>.
        </p>
        <p>
          <b>wicked-vault is absorbed</b> as of 0.7.3 — the evidence hash chain,
          verifier registry, and vault CLI ship in-package. wicked-bus events and
          wicked-brain memory writes are optional: absent either, it no-ops.
        </p>
      </div>
      <div class="ledger-tree" aria-hidden="true">
        <div class="ledger-tree-bar"><i></i><i></i><i></i><span>.wicked-testing/</span></div>
        <pre><code><span class="k">.wicked-testing/</span>
  wicked-testing.db      <span class="c">SQLite ledger · WAL · 7 tables</span>
  evidence/
    &lt;run-id&gt;/
      manifest.json      <span class="c">public contract</span>
      evidence.json      <span class="c">executor summary</span>
      step-N.json        <span class="c">per-step artifacts</span>
      context.md         <span class="c">cold reviewer context</span>
  verdicts/&#123;id&#125;.json     <span class="c">traceable to the run</span></code></pre>
      </div>
    </div>
  </section>

  <!-- ── Closer / install ─────────────────────────────────────────────────── -->
  <div class="finale">
    <section class="closer">
      <div class="wrap closer-grid">
        <div class="closer-intro">
          <span class="kicker">Get started</span>
          <h2>Give your agent a QE team it can't out-argue.</h2>
          <p>
            Local-first and SQLite-backed. MIT-licensed, published to npm as
            <code>wicked-testing</code> v0.7.3. The <code>wicked-qe</code> rename is
            pending — the <code>wicked-qe</code> bin alias already ships.
          </p>
        </div>
        <div class="install install--closer" role="group" aria-label="Install wicked-testing">
          <div class="install__bar">
            <span class="install__label">Install · the wicked family</span>
            <button class="install__copy" type="button" aria-label="Copy installer command"
              onclick="navigator.clipboard&&navigator.clipboard.writeText('npx wicked-installer').then(()=>{this.textContent='Copied';setTimeout(()=>{this.textContent='Copy';},1400);})">Copy</button>
          </div>
          <pre class="install__code"><code><span class="p">npx</span> wicked-installer   <span class="c"># interactive · cross-CLI · ships the wicked CLI</span></code></pre>
          <p class="install__alt">
            <span class="install__or">or install just this directly:</span>
            <code>npx wicked-testing install</code> — or the Claude Code plugin
            <code>claude plugins install wicked-testing</code>
          </p>
        </div>
        <a class="gh-pill" href="https://github.com/mikeparcewski/wicked-testing#readme" target="_blank" rel="noopener" aria-label="View on GitHub">
          <svg viewBox="0 0 16 16" width="42" height="42" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.02-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
          <span>View on GitHub</span>
        </a>
      </div>
    </section>

    <SameGarden current="wicked-testing" />

    <Footer repo={repo} />
  </div>

  <!-- Interactive: self-grade reveal · live wall handoff · fleet filter. Vanilla, reduced-motion safe. -->
  <script is:inline>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ── Self-grade vs reviewed reveal ─────────────────────────────── */
      var fig = document.getElementById('cardfig');
      if (fig) {
        var btn = fig.querySelector('[data-reveal]');
        var mark = fig.querySelector('[data-revmark]');
        var sub = fig.querySelector('[data-revsub]');
        btn.addEventListener('click', function () {
          var on = fig.getAttribute('data-revealed') === 'true';
          fig.setAttribute('data-revealed', on ? 'false' : 'true');
          btn.setAttribute('aria-pressed', on ? 'false' : 'true');
          if (mark) mark.textContent = on ? 'PASS' : 'FAIL';
          if (sub) sub.textContent = on ? 'awaiting review…' : 'caught a real bug';
          btn.textContent = on ? 'Send it to an independent reviewer →' : '↺ Reset';
        });
      }

      /* ── The wall: play/pause the live handoff, light a role on click ─ */
      var stage = document.getElementById('stage');
      if (stage) {
        if (reduce) stage.classList.remove('is-playing');
        var roles = Array.prototype.slice.call(stage.querySelectorAll('.role'));
        stage.addEventListener('click', function (e) {
          var role = e.target.closest('.role');
          if (role) {
            roles.forEach(function (r) { r.classList.toggle('is-lit', r === role); });
            return;
          }
          stage.classList.toggle('is-playing');
        });
      }

      /* ── Fleet filter: pick a surface, matching agents light up ──────── */
      var grid = document.getElementById('fleetGrid');
      var filter = document.getElementById('fleetFilter');
      if (grid && filter) {
        var fbtns = Array.prototype.slice.call(filter.querySelectorAll('.f-btn'));
        var agents = Array.prototype.slice.call(grid.querySelectorAll('.agent'));
        var cycle = null;

        function apply(surf) {
          fbtns.forEach(function (b) {
            var on = b.getAttribute('data-surf') === surf;
            b.classList.toggle('is-on', on);
            b.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          if (surf === 'all') {
            grid.classList.remove('is-filtered');
            agents.forEach(function (a) { a.classList.remove('is-match'); });
          } else {
            grid.classList.add('is-filtered');
            agents.forEach(function (a) { a.classList.toggle('is-match', a.getAttribute('data-surf') === surf); });
          }
        }
        function stopCycle() { if (cycle) { clearInterval(cycle); cycle = null; } }

        fbtns.forEach(function (b) {
          b.addEventListener('click', function () { stopCycle(); apply(b.getAttribute('data-surf')); });
        });

        /* auto-demo: cycle through the five surfaces until the user interacts */
        if (!reduce) {
          var order = ['plan', 'authoring', 'execution', 'review', 'insight'];
          var i = -1;
          cycle = setInterval(function () { i = (i + 1) % order.length; apply(order[i]); }, 2200);
        }
      }
    })();
  </script>
</Base>
