{
  "name": "wicked-testing",
  "version": "0.11.0",
  "type": "module",
  "description": "RETIRED \u2014 folded into the wicked-* ecosystem: skills \u2192 wicked-garden (the qe domain), acceptance gate \u2192 wicked-crew, data layer \u2192 wicked-ledger + wicked-vault. This final release is the post-carve state so ^0.10 pinners resolve to a truthful package.",
  "keywords": [
    "ai",
    "testing",
    "qe",
    "quality-engineering",
    "acceptance-testing",
    "skills",
    "claude-code",
    "gemini-cli",
    "cursor",
    "codex",
    "kiro",
    "sqlite",
    "test-oracle",
    "wicked-garden"
  ],
  "author": "Mike Parcewski",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikeparcewski/wicked-testing.git"
  },
  "homepage": "https://github.com/mikeparcewski/wicked-testing",
  "bugs": "https://github.com/mikeparcewski/wicked-testing/issues",
  "main": "install.mjs",
  "bin": {
    "wicked-testing": "install.mjs",
    "wicked-testing-install": "install.mjs",
    "wicked-qe": "bin/wicked-qe.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.0",
    "wicked-ledger": "^0.1.0",
    "wicked-vault": "^0.4.4"
  },
  "files": [
    "install.mjs",
    "bin/",
    "skills/",
    "hooks/",
    "lib/",
    "scripts/_python.sh",
    "scenarios/",
    "schemas/",
    "docs/",
    ".claude-plugin/",
    "README.md",
    "ARCHITECTURE.md",
    "HOW-IT-WORKS.md",
    "SCENARIO-FORMAT.md",
    "DATA-DOMAIN.md"
  ],
  "scripts": {
    "status": "node install.mjs status",
    "doctor": "node install.mjs doctor",
    "test": "node scripts/dev/validate.mjs && node scripts/dev/sync-plugin-version.mjs --check --quiet",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\" \"hooks/**/*.test.mjs\"",
    "prepublishOnly": "node scripts/dev/sync-plugin-version.mjs && node scripts/dev/validate.mjs",
    "evals:list": "node scripts/dev/evals.mjs list",
    "evals:plan": "node scripts/dev/evals.mjs plan",
    "evals:summary": "node scripts/dev/evals-summary.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
